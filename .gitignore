# Vivado transient state
.Xil/
DPLL_Rewrite.cache/
DPLL_Rewrite.hw/
DPLL_Rewrite.ip_user_files/
DPLL_Rewrite.sim/

# Vivado run directories: ignore intermediates, keep build outputs and reports.
DPLL_Rewrite.runs/**
!DPLL_Rewrite.runs/
!DPLL_Rewrite.runs/**/
!DPLL_Rewrite.runs/**/*.bit
!DPLL_Rewrite.runs/**/*.dcp
!DPLL_Rewrite.runs/**/*.hwdef
!DPLL_Rewrite.runs/**/*.sysdef
!DPLL_Rewrite.runs/**/*.ltx
!DPLL_Rewrite.runs/**/*.rpt
!DPLL_Rewrite.runs/**/*.rpx

# Vivado logs/journals and webtalk noise
*.jou
*.log
*.backup.jou
*.backup.log
*.pb
*.wdf
*.wpc
usage_statistics_webtalk.*
usage_statistics_ext_sdk.*
webtalk*.jou
webtalk*.log
xsim*.jou
xsim*.log
xelab.pb
xvlog.pb
*.wdb

# Local xsim project scratch. Keep selected reports/logs by force-adding.
reports/xsim/**/xsim.dir/
reports/xsim/**/.Xil/
reports/xsim/clock_valid_stage_a/
reports/xsim/dac0_probe_current/
reports/xsim/dc_blocker_stage_a_cli_*/
reports/xsim/**/clock_valid_stage_a.cache/
reports/xsim/**/clock_valid_stage_a.hw/
reports/xsim/**/clock_valid_stage_a.ip_user_files/
reports/xsim/**/clock_valid_stage_a.sim/

# Xilinx SDK / Eclipse workspace metadata
DPLL_Rewrite.sdk/.metadata/
DPLL_Rewrite.sdk/.sdk/
DPLL_Rewrite.sdk/RemoteSystemsTempFiles/
DPLL_Rewrite.sdk/webtalk/

# SDK build directories: keep final firmware/application artifacts.
DPLL_Rewrite.sdk/**/Debug/**
DPLL_Rewrite.sdk/**/Release/**
!DPLL_Rewrite.sdk/**/Debug/
!DPLL_Rewrite.sdk/**/Release/
!DPLL_Rewrite.sdk/**/Debug/*.elf
!DPLL_Rewrite.sdk/**/Debug/*.elf.size
!DPLL_Rewrite.sdk/**/Release/*.elf
!DPLL_Rewrite.sdk/**/Release/*.elf.size

# Compiled objects and dependency files
*.o
*.obj
*.d
*.a
!DPLL_Rewrite.sdk/DPLL_fsbl_bsp/ps7_cortexa9_0/libsrc/xilrsa_v1_5/src/librsa.a
*.pdom
*.index
__pycache__/
*.py[cod]

# Local/editor files
.codex/backups/
*.tmp
*.bak
*.swp
Thumbs.db
desktop.ini

# Local MATLAB capture and replay datasets
/MCU_src/simudate/data/

# Build-generated FPGA/ARM identity headers are compiler inputs.
# Do not ignore them, otherwise `git clean -X` removes the macros needed by
# dpll_wrapper.v and the ARM firmware.
