# Location of BUFG Primitives 
set_property LOC BUFGCTRL_X0Y1 [get_cells bufg_ser_clk]
set_property LOC BUFGCTRL_X0Y12 [get_cells pll/BUFG_inst]
set_property LOC BUFGCTRL_X0Y11 [get_cells nolabel_line678/inst/clkf_buf]
set_property LOC BUFGCTRL_X0Y4 [get_cells nolabel_line678/inst/clkout1_buf]
set_property LOC BUFGCTRL_X0Y2 [get_cells i_ps/system_i/system_i/processing_system7_0/inst/buffer_fclk_clk_3.FCLK_CLK_3_BUFG]
set_property LOC BUFGCTRL_X0Y9 [get_cells dpll_wrapper_inst/bufg_dpll_clk]
set_property LOC BUFGCTRL_X0Y6 [get_cells bufg_dac_clk_2x]
set_property LOC BUFGCTRL_X0Y5 [get_cells bufg_dac_clk_2p]
set_property LOC BUFGCTRL_X0Y3 [get_cells bufg_dac_clk_1x]
set_property LOC BUFGCTRL_X0Y0 [get_cells bufg_adc_clk]
set_property LOC BUFGCTRL_X0Y8 [get_cells Digital_Freq_Meter_inst/bufg_fm_rst]
set_property LOC BUFGCTRL_X0Y10 [get_cells Digital_Freq_Meter_inst/bufg_dpll_clk]
set_property LOC BUFGCTRL_X0Y7 [get_cells bufg_dpll_clk]

# Location of IO Primitives which is load of clock spine
set_property LOC IOB_X0Y28 [get_cells daisy_p_o_OBUF[1]_inst]

# Location of clock ports
set_property LOC IOB_X0Y25 [get_ports adc_clk_n_i]
set_property LOC IOB_X0Y26 [get_ports adc_clk_p_i]

# Clock net "pwm_clk" driven by instance "bufg_ser_clk" located at site "BUFGCTRL_X0Y1"
#startgroup
create_pblock {CLKAG_pwm_clk}
add_cells_to_pblock [get_pblocks  {CLKAG_pwm_clk}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL } -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="pwm_clk"}]]]
resize_pblock [get_pblocks {CLKAG_pwm_clk}] -add {CLOCKREGION_X0Y0:CLOCKREGION_X0Y0 CLOCKREGION_X0Y1:CLOCKREGION_X0Y1 CLOCKREGION_X1Y0:CLOCKREGION_X1Y0 CLOCKREGION_X1Y1:CLOCKREGION_X1Y1}
#endgroup

# Clock net "nolabel_line678/inst/clk_out1" driven by instance "nolabel_line678/inst/clkout1_buf" located at site "BUFGCTRL_X0Y4"
#startgroup
create_pblock {CLKAG_nolabel_line678/inst/clk_out1}
add_cells_to_pblock [get_pblocks  {CLKAG_nolabel_line678/inst/clk_out1}] [get_cells -filter { PRIMITIVE_GROUP != I/O && IS_PRIMITIVE==1 && PRIMITIVE_LEVEL !=INTERNAL && NAME!=daisy_p_o_OBUF[1]_inst} -of_object [get_pins -filter {DIRECTION==IN} -of_objects [get_nets -hierarchical -filter {PARENT=="nolabel_line678/inst/clk_out1"}]]]
resize_pblock [get_pblocks {CLKAG_nolabel_line678/inst/clk_out1}] -add {CLOCKREGION_X1Y0:CLOCKREGION_X1Y0}
#endgroup

